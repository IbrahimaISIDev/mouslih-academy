# Voir README.md pour le détail. Défaut : mocks (aucune variable requise pour développer sans
# backend). Pour brancher l'API réelle (voir ../mouslih-academy-backend) :
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# URL publique de CE site — sert de base aux URLs absolues des métadonnées (Open Graph, image de
# partage) : à remplacer par le vrai domaine en production, sinon les liens partagés sur
# WhatsApp/Facebook pointent vers localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
